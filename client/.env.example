# Example environment variables for SmartAccounting Frontend
# Copy to .env and adjust as needed


# === FINAL APPROVED API STRATEGY ===
#
# DEV (Local, no Docker):
# VITE_API_URL=/api
#
# DEV (Docker Compose):
# VITE_API_URL=/api
#
# PROD (Reverse Proxy):
# VITE_API_URL=/api
#
# ❌ Never use Docker service names in browser env!

VITE_API_URL=/api
VITE_APP_ENV=development
VITE_AI_ASSISTANT_ENABLED=true
VITE_AI_VOICE_ENABLED=true
